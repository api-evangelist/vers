{
  "opencollection": "1.0.0",
  "info": {
    "name": "Orchestrator Control Plane commit_tags keys API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "validate_key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/keys/validate",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}